# Docker ignore file for SigmaFlow
# Excludes unnecessary files from build context

# Git
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
MANIFEST
.venv/
venv/
env/
conda/
.conda/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.pytype/

# Virtual environments
.env
.env.local
.env.production

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# LaTeX
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out

# Temp
*.tmp
*.bak
*.swp
~$*

# Frontend
frontend/.next/
frontend/node_modules/
frontend/out/

# Database
*.db
*.sqlite

# Output directories
output/
logs/
figures/
reports/
*.log

# Documentation
docs/_build/
*.md

# Tests
tests/__pycache__/
test_*.py
test_sprint*.py

# Root-owned files and directories to exclude from build context
alembic/
alembic.ini
docker-compose.yml
uv.lock
GAP_ANALYSIS.md
sigmaflow.db
sigmaflow.egg-info/
*.pyc

