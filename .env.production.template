# SigmaFlow Production Environment Variables
# ==========================================
# Copy this file to .env.production and fill in all values
# NEVER commit actual secrets to version control!

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SigmaFlow
APP_VERSION=0.2.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL with asyncpg for FastAPI, psycopg2 for sync operations
DATABASE_URL_SYNC=postgresql+psycopg2://sigmaflow:CHANGE_ME@postgres:5432/sigmaflow
DATABASE_URL_ASYNC=postgresql+asyncpg://sigmaflow:CHANGE_ME@postgres:5432/sigmaflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ── Security / Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ── File Storage ──────────────────────────────────────────────────────────
# Options: local, s3, minio
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/app/storage

# S3/MinIO (if STORAGE_TYPE != local)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_BUCKET=sigmaflow-production
# S3_REGION=us-east-1

# ── Input/Output Paths ──────────────────────────────────────────────────
INPUT_DIR=/app/input/datasets
OUTPUT_DIR=/app/output

# ── Dashboard / Report ──────────────────────────────────────────────────
DASHBOARD_ENABLED=true
REPORT_COMPILE_PDF=true
REPORT_ORGANIZATION=SigmaFlow

# ── External Integrations ───────────────────────────────────────────────
# Webhook URLs for notifications
WEBHOOK_TEAMS=https://outlook.office.com/webhook/CHANGE_ME
WEBHOOK_SLACK=https://hooks.slack.com/services/CHANGE_ME
WEBHOOK_GENERIC=https://your-webhook-endpoint.com/alerts

# Email (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_TLS=true
EMAIL_FROM=SigmaFlow <notifications@yourdomain.com>

# ── LLM (for enhanced insights) ─────────────────────────────────────────
# Options: none, groq, openrouter, openai, ollama
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Scheduler ───────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ── API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
# Comma-separated list of allowed origins
API_CORS_ORIGINS=https://sigmaflow.example.com,https://app.sigmaflow.example.com

# ── Default Values ──────────────────────────────────────────────────────
DEFAULT_PROJECT_CODE=SF
DEFAULT_RUN_CONFIG={}

# ── Monitoring / Observability ─────────────────────────────────────────
# Prometheus metrics endpoint (if enabled)
METRICS_ENABLED=true
METRICS_PORT=9090

# Structured logging for log aggregation
LOG_JSON=true

# Health check interval
HEALTH_CHECK_INTERVAL=30

# ── Feature Flags ───────────────────────────────────────────────────────
FEATURE_WEBHOOKS=true
FEATURE_SCHEDULER=true
FEATURE_LLM_INSIGHTS=false
FEATURE_EXPORT_PDF=true
FEATURE_MULTI_TENANT=true