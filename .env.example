# SigmaFlow Environment Configuration
# Copy this file to .env and adjust values as needed

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SigmaFlow
APP_VERSION=0.2.0
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, local development)
# Uses ./data/sigmaflow.db (auto-created, not versioned)
DATABASE_URL_SYNC=sqlite:///./data/sigmaflow.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./data/sigmaflow.db

# PostgreSQL (production)
# DATABASE_URL_SYNC=postgresql+psycopg2://user:pass@host:port/dbname
# DATABASE_URL_ASYNC=postgresql+asyncpg://user:pass@host:port/dbname

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ── Security / Auth ───────────────────────────────────────────────────────
# IMPORTANT: Change this in production! Use a long random string.
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ── File Storage ──────────────────────────────────────────────────────────
STORAGE_TYPE=local  # local, s3, minio
STORAGE_LOCAL_ROOT=./storage

# S3/MinIO (if STORAGE_TYPE != local)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1

# ── Input/Output Paths (legacy compatibility) ─────────────────────────────
INPUT_DIR=input/datasets
OUTPUT_DIR=output

# ── Dashboard / Report ────────────────────────────────────────────────────
DASHBOARD_ENABLED=true
REPORT_COMPILE_PDF=true
REPORT_ORGANIZATION=SigmaFlow

# ── External Integrations ─────────────────────────────────────────────────
# WEBHOOK_TEAMS=https://outlook.office.com/webhook/...
# WEBHOOK_SLACK=https://hooks.slack.com/services/...
# WEBHOOK_GENERIC=https://your-webhook-url

# Email (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=true
# EMAIL_FROM=SigmaFlow <noreply@sigmaflow.com>

# ── LLM (for enhanced insights) ───────────────────────────────────────────
LLM_PROVIDER=none  # none, groq, openrouter, openai, ollama
# LLM_API_KEY=your-api-key
LLM_MODEL=llama-3.1-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Scheduler ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ── API ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=["*"]

# ── Default Values ────────────────────────────────────────────────────────
DEFAULT_PROJECT_CODE=SF
DEFAULT_RUN_CONFIG={}