# SigmaFlow Staging Environment Variables
# ========================================
# Copy this file to .env.staging and fill in all values
# Used for staging environment deployment

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SigmaFlow
APP_VERSION=0.2.0
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ── Database ──────────────────────────────────────────────────────────────
# Staging database (separate from production)
DATABASE_URL_SYNC=postgresql+psycopg2://sigmaflow:staging_password@postgres:5432/sigmaflow_staging
DATABASE_URL_ASYNC=postgresql+asyncpg://sigmaflow:staging_password@postgres:5432/sigmaflow_staging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ── Security / Auth ──────────────────────────────────────────────────────
# Staging secret (different from production!)
SECRET_KEY=staging-secret-key-change-me-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# ── File Storage ──────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/app/storage

# ── Input/Output Paths ──────────────────────────────────────────────────
INPUT_DIR=/app/input/datasets
OUTPUT_DIR=/app/output

# ── Dashboard / Report ──────────────────────────────────────────────────
DASHBOARD_ENABLED=true
REPORT_COMPILE_PDF=true
REPORT_ORGANIZATION=SigmaFlow Staging

# ── External Integrations ───────────────────────────────────────────────
WEBHOOK_TEAMS=
WEBHOOK_SLACK=
WEBHOOK_GENERIC=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=SigmaFlow Staging <staging@sigmaflow.example.com>

# ── LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Scheduler ───────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Sao_Paulo

# ── API ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_CORS_ORIGINS=https://staging.sigmaflow.example.com,http://localhost:3000

# ── Default Values ──────────────────────────────────────────────────────
DEFAULT_PROJECT_CODE=SF
DEFAULT_RUN_CONFIG={}

# ── Monitoring ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_JSON=true
HEALTH_CHECK_INTERVAL=30

# ── Feature Flags ───────────────────────────────────────────────────────
FEATURE_WEBHOOKS=true
FEATURE_SCHEDULER=true
FEATURE_LLM_INSIGHTS=false
FEATURE_EXPORT_PDF=true
FEATURE_MULTI_TENANT=true